{
  "mcpServers": {
    "marketton": {
      "command": ".venv/Scripts/python.exe",
      "args": [
        "-m",
        "mcp_server"
      ],
      "env": {
        "MARKETTON_API_URL": "${MARKETTON_API_URL:-http://127.0.0.1:8000}",
        "MARKETTON_AGENT_USER": "${MARKETTON_AGENT_USER}",
        "MARKETTON_AGENT_PASSWORD": "${MARKETTON_AGENT_PASSWORD}"
      }
    }
  }
}
