# Tela do marketTon (React) servida pelo Caddy, que também faz o HTTPS automático e repassa /api/* para a API.
FROM node:22-alpine AS build
WORKDIR /w
COPY frontend_app/package.json ./
RUN npm install --no-audit --no-fund
COPY frontend_app/ ./
ARG VITE_API_BASE=/api
ENV VITE_API_BASE=${VITE_API_BASE}
RUN npx vite build

FROM caddy:2-alpine
COPY --from=build /w/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
