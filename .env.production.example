# Copie para `.env.production` NO SERVIDOR e preencha. NUNCA commite o arquivo preenchido.
#   cp .env.production.example .env.production

# Endereço do painel (o DNS precisa apontar para o servidor; o HTTPS é automático).
DOMAIN=app.felixsystems.com.br

# Banco: senha forte e única (o usuário e o banco são "marketton").
POSTGRES_PASSWORD=TROQUE-POR-UMA-SENHA-LONGA

# Assina os logins. Gere com: openssl rand -hex 48
JWT_SECRET_KEY=TROQUE-POR-UM-SEGREDO-LONGO

# Primeiro administrador (só é usado se o banco ainda não tiver usuários; depois, os usuários vêm da própria API).
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# A tela e a API ficam no mesmo endereço: não precisa de CORS para outro site.
CORS_ORIGINS=https://app.felixsystems.com.br
AUTH_ENABLED=true

# O agente roda em segundo plano (rotinas da manhã e da noite, chat, ativação).
AGENT_AUTORUN=true
