# Copie para `.env` e preencha. NUNCA commite o `.env`.
#   cp .env.example .env

# --- Banco de dados -----------------------------------------------------------
# Formato SQLAlchemy. Para rodar a API no host com o docker compose:
DATABASE_URL=postgresql+psycopg://marketton:marketton@localhost:5432/marketton
POSTGRES_DB=marketton
POSTGRES_USER=marketton
POSTGRES_PASSWORD=marketton
POSTGRES_PORT=5432

# --- Cache / fila -------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# --- API ----------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
RELOAD=true
API_PORT=8000
# O frontend React roda em 5173. Sem isto o browser é bloqueado pelo CORS.
CORS_ORIGINS=http://localhost:5173

# --- Mercado Livre ------------------------------------------------------------
# https://developers.mercadolivre.com.br/ — app do tipo "Server Side".
MARKETPLACE_MERCADOLIVRE_ENABLED=true
MARKETPLACE_MERCADOLIVRE_CLIENT_ID=
MARKETPLACE_MERCADOLIVRE_CLIENT_SECRET=
MARKETPLACE_MERCADOLIVRE_REDIRECT_URI=http://localhost:8000/marketplaces/mercadolivre/callback
MARKETPLACE_MERCADOLIVRE_ACCESS_TOKEN=
MARKETPLACE_MERCADOLIVRE_REFRESH_TOKEN=
MARKETPLACE_MERCADOLIVRE_SITE_ID=MLB
MARKETPLACE_MERCADOLIVRE_COUNTRY=BR

# --- Shopee -------------------------------------------------------------------
# https://open-api.affiliate.shopee.com.br/ — Affiliate Open API (GraphQL).
# Exige aprovação como parceiro afiliado. Sem OAuth por loja: app_id/secret
# assinam cada requisição diretamente.
MARKETPLACE_SHOPEE_ENABLED=false
MARKETPLACE_SHOPEE_APP_ID=
MARKETPLACE_SHOPEE_SECRET=

# --- Amazon -------------------------------------------------------------------
# https://affiliate-program.amazon.com/creatorsapi/ — Creators API.
# Substitui a PA-API 5.0, aposentada pela Amazon. OAuth2 client_credentials
# (Bearer token), não assinatura AWS. Exige conta de Associado aprovada com
# vendas qualificadas recentes (10 nos últimos 30 dias para manter acesso).
MARKETPLACE_AMAZON_ENABLED=false
MARKETPLACE_AMAZON_CLIENT_ID=
MARKETPLACE_AMAZON_CLIENT_SECRET=
MARKETPLACE_AMAZON_PARTNER_TAG=
MARKETPLACE_AMAZON_MARKETPLACE=www.amazon.com.br

# --- TikTok Shop --------------------------------------------------------------
# https://partner.tiktokshop.com/ — Affiliate Open API.
MARKETPLACE_TIKTOKSHOP_ENABLED=false
MARKETPLACE_TIKTOKSHOP_APP_KEY=
MARKETPLACE_TIKTOKSHOP_APP_SECRET=
MARKETPLACE_TIKTOKSHOP_ACCESS_TOKEN=

# --- Camada de IA (agentes) ---------------------------------------------------
# OpenAI-compatível. Deixe AI_ENABLED=false para rodar 100% determinístico.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Meta Ads (Marketing API / Ads Library) -----------------------------------
# https://developers.facebook.com/docs/marketing-apis/
# Sem o token, a Ads Library responde 401. Insumo do Creative Saturation Score.
META_ACCESS_TOKEN=
META_AD_ACCOUNT=

# --- Autenticação -------------------------------------------------------------
# GERE UM SEGREDO PRÓPRIO antes de expor a API:
#   python -c "from core.services.security import generate_jwt_secret as g; print(g())"
# Enquanto este valor não for trocado, /health reporta o bloqueador
# "JWT_SECRET_KEY ainda é o valor de desenvolvimento".
JWT_SECRET_KEY=dev-only-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
AUTH_ENABLED=true

# Administrador inicial. Só é criado quando a tabela de usuários está VAZIA — é o
# caminho de entrada, já que a API exige autenticação. REMOVA estas duas linhas do
# .env depois que a conta existir.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Coleta -------------------------------------------------------------------
# Intervalo do ciclo completo do pipeline, em segundos.
AGENT_CYCLE_INTERVAL_SECONDS=3600
